# Simple 3D arrow pointing forward (vanishing into +Z)
# Viewed from above-front at slight angle

# Arrow tip (pointing forward/up)
v 0 15 0

# Arrow base corners
v -4 -5 0
v 4 -5 0

# Arrow tail (pointing backward, in distance for vanishing effect)
v -3 -8 2
v 3 -8 2

# Arrow edges
l 1 2
l 1 3
l 2 3
l 2 4
l 3 5
l 4 5
l 4 1
l 5 1
